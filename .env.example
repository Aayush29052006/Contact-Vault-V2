# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Flask
SECRET_KEY=replace-with-a-random-secret-key
FLASK_ENV=development

# Database (SQLite by default — no setup needed)
DATABASE_URL=sqlite:///instance/contactvault.db

# Google OAuth
# Create your own credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/auth/login/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
