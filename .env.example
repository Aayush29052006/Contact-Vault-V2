# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Flask
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key
FLASK_ENV=development

# Database - leave unset to use SQLite automatically (zero setup).
# Only set this if you want to point at a different database, e.g.
# PostgreSQL later: DATABASE_URL=postgresql://user:pass@host/dbname
# DATABASE_URL=

# Google OAuth
# Create your own credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/auth/login/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
